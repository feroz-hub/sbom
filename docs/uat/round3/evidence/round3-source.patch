+                          trigger_source='api', started_on='2026-10-20T00:00:00Z',
+                          completed_on='2026-10-20T00:00:00Z')
+        db.add(run)
+        db.commit()
+        run_id = run.id
+    return call, identity, internal, foreign.json()['id'], run_id
