"4.17.21"}]}],"versions":["0.10.0","0.7.0","0.8.1","0.8.2","0.9.0","0.9.1","0.9.2","1.0.0.rc.1","1.0.0.rc.2","1.0.0.rc.3","1.0.1","1.1.0","1.1.1","1.2.0","1.2.1","1.3.1","2.0.0","2.1.0","2.2.0","2.2.1","2.3.0","2.4.0","2.4.1","3.1.0","3.10.0","3.10.1","3.2.0","3.3.0","3.3.1","3.3.1.1","3.4.0","3.5.0","3.6.0","3.7.0","3.9.3","4.0.0","4.11.2","4.12.0","4.13.1","4.14.1","4.15.0","4.16.1","4.16.3","4.16.4","4.16.6","4.17.10","4.17.11","4.17.14","4.17.15","4.17.2","4.17.4","4.17.5","4.3.0","4.5.1","4.6.1"],"database_specific":{"source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2021/05/GHSA-35jh-r3h4-6jhm/GHSA-35jh-r3h4-6jhm.json"}}],"schema_version":"1.9.0","severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:H/I:H/A:H"}]},"match_confidence":0.812,"provider":"OSV"}]}},{"ruleId":"CVE-2025-13465","level":"warning","message":{"text":"Lodash has Prototype Pollution Vulnerability in `_.unset` and `_.omit` functions"},"locations":[{"logicalLocations":[{"name":"lodash","fullyQualifiedName":"pkg:npm/lodash@4.17.20"}]}],"properties":{"score":6.5,"cpe":null,"published":"2026-01-21T23:01:22Z","cve_aliases":[],"vex_status":null,"vex_source":null,"match_strategy":"purl_direct","match_reason":"osv_version_qualified_query","matched_range":null,"match_confidence":0.812,"cvss_source":"OSV","cvss_version":"3.1","source_observations":[{"vuln_id":"GHSA-xxjr-mmjv-4gpg","aliases":["CVE-2025-13465"],"sources":["OSV"],"description":"Lodash has Prototype Pollution Vulnerability in `_.unset` and `_.omit` functions","severity":"MEDIUM","score":6.5,"vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:L/A:L","attack_vector":"Network","cvss_version":"3.1","published":"2026-01-21T23:01:22Z","references":["https://github.com/lodash/lodash/security/advisories/GHSA-xxjr-mmjv-4gpg","https://nvd.nist.gov/vuln/detail/CVE-2025-13465","https://github.com/lodash/lodash/commit/edadd452146f7e4bad4ea684e955708931d84d81","https://cert-portal.siemens.com/productcert/html/ssa-253495.html","https://github.com/lodash/lodash"],"cwe":["CWE-1321"],"fixed_versions":["4.17.23"],"component_name":"lodash","component_version":"4.17.20","cpe":null,"match_strategy":"purl_direct","component_id":"501da68f-30a2-49ee-b2a7-d3c0d2ce4626","sbom_id":"f5e7f4c4-8a16-4c70-93d8-092173885437","tenant_id":"3a900179-36bf-4b5f-b2e1-2a4a9d06e6af","bom_ref":"uat-lodash","purl":"pkg:npm/lodash@4.17.20","ecosystem":"npm","normalized_name":"lodash","applicability_status":"affected","applicability":{"status":"affected","reason":"osv_version_qualified_query","affected":[{"package":{"name":"lodash","ecosystem":"npm","purl":"pkg:npm/lodash"},"ranges":[{"type":"SEMVER","events":[{"introduced":"4.0.0"},{"fixed":"4.17.23"}]}],"database_specific":{"last_known_affected_version_range":"<= 4.17.22","source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/01/GHSA-xxjr-mmjv-4gpg/GHSA-xxjr-mmjv-4gpg.json"}}]},"match_reason":"osv_version_qualified_query","query_trace":{"path":"querybatch","query":{"package":{"purl":"pkg:npm/lodash@4.17.20"}}},"provider_raw":{"id":"GHSA-xxjr-mmjv-4gpg","summary":"Lodash has Prototype Pollution Vulnerability in `_.unset` and `_.omit` functions","details":"### Impact\n\nLodash versions 4.0.0 through 4.17.22 are vulnerable to prototype pollution in the `_.unset` and `_.omit` functions. An attacker can pass crafted paths which cause Lodash to delete methods from global prototypes. \n\nThe issue permits deletion of properties but does not allow overwriting their original behavior.  \n\n### Patches\n\nThis issue is patched on 4.17.23.","aliases":["CVE-2025-13465"],"modified":"2026-10-17T02:55:54.229635593Z","published":"2026-01-21T23:01:22Z","database_specific":{"severity":"MODERATE","github_reviewed":true,"github_reviewed_at":"2026-01-21T23:01:22Z","nvd_published_at":"2026-01-21T20:16:05Z","cwe_ids":["CWE-1321"]},"references":[{"type":"WEB","url":"https://github.com/lodash/lodash/security/advisories/GHSA-xxjr-mmjv-4gpg"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2025-13465"},{"type":"WEB","url":"https://github.com/lodash/lodash/commit/edadd452146f7e4bad4ea684e955708931d84d81"},{"type":"WEB","url":"https://cert-portal.siemens.com/productcert/html/ssa-253495.html"},{"type":"PACKAGE","url":"https://github.com/lodash/lodash"}],"affected":[{"package":{"name":"lodash","ecosystem":"npm","purl":"pkg:npm/lodash"},"ranges":[{"type":"SEMVER","events":[{"introduced":"4.0.0"},{"fixed":"4.17.23"}]}],"database_specific":{"last_known_affected_version_range":"<= 4.17.22","source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/01/GHSA-xxjr-mmjv-4gpg/GHSA-xxjr-mmjv-4gpg.json"}},{"package":{"name":"lodash.unset","ecosystem":"npm","purl":"pkg:npm/lodash.unset"},"ranges":[{"type":"SEMVER","events":[{"introduced":"4.0.0"},{"last_affected":"4.5.2"}]}],"database_specific":{"source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/01/GHSA-xxjr-mmjv-4gpg/GHSA-xxjr-mmjv-4gpg.json"}},{"package":{"name":"lodash-es","ecosystem":"npm","purl":"pkg:npm/lodash-es"},"ranges":[{"type":"SEMVER","events":[{"introduced":"4.0.0"},{"fixed":"4.17.23"}]}],"database_specific":{"last_known_affected_version_range":"<= 4.17.22","source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/01/GHSA-xxjr-mmjv-4gpg/GHSA-xxjr-mmjv-4gpg.json"}},{"package":{"name":"lodash-amd","ecosystem":"npm","purl":"pkg:npm/lodash-amd"},"ranges":[{"type":"SEMVER","events":[{"introduced":"4.0.0"},{"fixed":"4.17.23"}]}],"database_specific":{"source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/01/GHSA-xxjr-mmjv-4gpg/GHSA-xxjr-mmjv-4gpg.json","last_known_affected_version_range":"<= 4.17.22"}}],"schema_version":"1.9.0","severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:L/A:L"},{"type":"CVSS_V4","score":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:L/VA:L/SC:H/SI:H/SA:H/E:P"}]},"match_confidence":0.812,"provider":"OSV"}]}},{"ruleId":"CVE-2026-2950","level":"warning","message":{"text":"lodash vulnerable to Prototype Pollution via array path bypass in `_.unset` and `_.omit`"},"locations":[{"logicalLocations":[{"name":"lodash","fullyQualifiedName":"pkg:npm/lodash@4.17.20"}]}],"properties":{"score":6.5,"cpe":null,"published":"2026-04-01T23:50:27Z","cve_aliases":[],"vex_status":null,"vex_source":null,"match_strategy":"purl_direct","match_reason":"osv_version_qualified_query","matched_range":null,"match_confidence":0.625,"cvss_source":"OSV","cvss_version":"3.1","source_observations":[{"vuln_id":"GHSA-f23m-r3pf-42rh","aliases":["CVE-2026-2950"],"sources":["OSV"],"description":"lodash vulnerable to Prototype Pollution via array path bypass in `_.unset` and `_.omit`","severity":"MEDIUM","score":6.5,"vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:L/A:L","attack_vector":"Network","cvss_version":"3.1","published":"2026-04-01T23:50:27Z","references":["https://github.com/lodash/lodash/security/advisories/GHSA-f23m-r3pf-42rh","https://github.com/lodash/lodash/security/advisories/GHSA-xxjr-mmjv-4gpg","https://nvd.nist.gov/vuln/detail/CVE-2026-2950","https://github.com/lodash/lodash"],"cwe":["CWE-1321"],"fixed_versions":["4.18.0"],"component_name":"lodash","component_version":"4.17.20","cpe":null,"match_strategy":"purl_direct","component_id":"501da68f-30a2-49ee-b2a7-d3c0d2ce4626","sbom_id":"f5e7f4c4-8a16-4c70-93d8-092173885437","tenant_id":"3a900179-36bf-4b5f-b2e1-2a4a9d06e6af","bom_ref":"uat-lodash","purl":"pkg:npm/lodash@4.17.20","ecosystem":"npm","normalized_name":"lodash","applicability_status":"affected","applicability":{"status":"affected","reason":"osv_version_qualified_query","affected":[{"package":{"name":"lodash","ecosystem":"npm","purl":"pkg:npm/lodash"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"4.18.0"}]}],"database_specific":{"last_known_affected_version_range":"<= 4.17.23","source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/04/GHSA-f23m-r3pf-42rh/GHSA-f23m-r3pf-42rh.json"}}]},"match_reason":"osv_version_qualified_query","query_trace":{"path":"querybatch","query":{"package":{"purl":"pkg:npm/lodash@4.17.20"}}},"provider_raw":{"id":"GHSA-f23m-r3pf-42rh","summary":"lodash vulnerable to Prototype Pollution via array path bypass in `_.unset` and `_.omit`","details":"### Impact\n\nLodash versions 4.17.23 and earlier are vulnerable to prototype pollution in the `_.unset` and `_.omit` functions. The fix for [CVE-2025-13465](https://github.com/lodash/lodash/security/advisories/GHSA-xxjr-mmjv-4gpg) only guards against string key members, so an attacker can bypass the check by passing array-wrapped path segments. This allows deletion of properties from built-in prototypes such as `Object.prototype`, `Number.prototype`, and `String.prototype`.\n\nThe issue permits deletion of prototype properties but does not allow overwriting their original behavior.\n\n### Patches\n\nThis issue is patched in 4.18.0.\n\n### Workarounds\n\nNone. Upgrade to the patched version.","aliases":["CVE-2026-2950"],"modified":"2026-10-17T02:56:13.084362346Z","published":"2026-04-01T23:50:27Z","database_specific":{"github_reviewed_at":"2026-04-01T23:50:27Z","nvd_published_at":"2026-03-31T20:16:26Z","cwe_ids":["CWE-1321"],"severity":"MODERATE","github_reviewed":true},"references":[{"type":"WEB","url":"https://github.com/lodash/lodash/security/advisories/GHSA-f23m-r3pf-42rh"},{"type":"WEB","url":"https://github.com/lodash/lodash/security/advisories/GHSA-xxjr-mmjv-4gpg"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-2950"},{"type":"PACKAGE","url":"https://github.com/lodash/lodash"}],"affected":[{"package":{"name":"lodash","ecosystem":"npm","purl":"pkg:npm/lodash"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"4.18.0"}]}],"database_specific":{"last_known_affected_version_range":"<= 4.17.23","source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/04/GHSA-f23m-r3pf-42rh/GHSA-f23m-r3pf-42rh.json"}},{"package":{"name":"lodash-es","ecosystem":"npm","purl":"pkg:npm/lodash-es"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"4.18.0"}]}],"database_specific":{"last_known_affected_version_range":"<= 4.17.23","source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/04/GHSA-f23m-r3pf-42rh/GHSA-f23m-r3pf-42rh.json"}},{"package":{"name":"lodash-amd","ecosystem":"npm","purl":"pkg:npm/lodash-amd"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"4.18.0"}]}],"database_specific":{"last_known_affected_version_range":"<= 4.17.23","source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/04/GHSA-f23m-r3pf-42rh/GHSA-f23m-r3pf-42rh.json"}},{"package":{"name":"lodash.unset","ecosystem":"npm","purl":"pkg:npm/lodash.unset"},"ranges":[{"type":"SEMVER","events":[{"introduced":"4.0.0"},{"fixed":"4.18.0"}]}],"database_specific":{"source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/04/GHSA-f23m-r3pf-42rh/GHSA-f23m-r3pf-42rh.json"}}],"schema_version":"1.9.0","severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:L/A:L"}]},"match_confidence":0.625,"provider":"OSV"}]}},{"ruleId":"CVE-2026-4800","level":"error","message":{"text":"lodash vulnerable to Code Injection via `_.template` imports key names"},"locations":[{"logicalLocations":[{"name":"lodash","fullyQualifiedName":"pkg:npm/lodash@4.17.20"}]}],"properties":{"score":8.1,"cpe":null,"published":"2026-04-01T23:51:12Z","cve_aliases":[],"vex_status":null,"vex_source":null,"match_strategy":"purl_direct","match_reason":"osv_version_qualified_query","matched_range":null,"match_confidence":0.625,"cvss_source":"OSV","cvss_version":"3.1","source_observations":[{"vuln_id":"GHSA-r5fr-rjxr-66jc","aliases":["CVE-2026-4800"],"sources":["OSV"],"description":"lodash vulnerable to Code Injection via `_.template` imports key names","severity":"HIGH","score":8.1,"vector":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","attack_vector":"Network","cvss_version":"3.1","published":"2026-04-01T23:51:12Z","references":["https://github.com/lodash/lodash/security/advisories/GHSA-r5fr-rjxr-66jc","https://nvd.nist.gov/vuln/detail/CVE-2026-4800","https://github.com/lodash/lodash/commit/3469357cff396a26c363f8c1b5a91dde28ba4b1c","https://cna.openjsf.org/security-advisories.html","https://github.com/advisories/GHSA-35jh-r3h4-6jhm","https://github.com/lodash/lodash"],"cwe":["CWE-94"],"fixed_versions":["4.18.0"],"component_name":"lodash","component_version":"4.17.20","cpe":null,"match_strategy":"purl_direct","component_id":"501da68f-30a2-49ee-b2a7-d3c0d2ce4626","sbom_id":"f5e7f4c4-8a16-4c70-93d8-092173885437","tenant_id":"3a900179-36bf-4b5f-b2e1-2a4a9d06e6af","bom_ref":"uat-lodash","purl":"pkg:npm/lodash@4.17.20","ecosystem":"npm","normalized_name":"lodash","applicability_status":"affected","applicability":{"status":"affected","reason":"osv_version_qualified_query","affected":[{"package":{"name":"lodash","ecosystem":"npm","purl":"pkg:npm/lodash"},"ranges":[{"type":"SEMVER","events":[{"introduced":"4.0.0"},{"fixed":"4.18.0"}]}],"database_specific":{"last_known_affected_version_range":"<= 4.17.23","source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/04/GHSA-r5fr-rjxr-66jc/GHSA-r5fr-rjxr-66jc.json"}}]},"match_reason":"osv_version_qualified_query","query_trace":{"path":"querybatch","query":{"package":{"purl":"pkg:npm/lodash@4.17.20"}}},"provider_raw":{"id":"GHSA-r5fr-rjxr-66jc","summary":"lodash vulnerable to Code Injection via `_.template` imports key names","details":"### Impact\n\nThe fix for [CVE-2021-23337](https://github.com/advisories/GHSA-35jh-r3h4-6jhm) added validation for the `variable` option in `_.template` but did not apply the same validation to `options.imports` key names. Both paths flow into the same `Function()` constructor sink.\n\nWhen an application passes untrusted input as `options.imports` key names, an attacker can inject default-parameter expressions that execute arbitrary code at template compilation time.\n\nAdditionally, `_.template` uses `assignInWith` to merge imports, which enumerates inherited properties via `for..in`. If `Object.prototype` has been polluted by any other vector, the polluted keys are copied into the imports object and passed to `Function()`.\n\n### Patches\n\nUsers should upgrade to version 4.18.0.\n\nThe fix applies two changes:\n1. Validate `importsKeys` against the existing `reForbiddenIdentifierChars` regex (same check already used for the `variable` option)\n2. Replace `assignInWith` with `assignWith` when merging imports, so only own properties are enumerated\n\n### Workarounds\n\nDo not pass untrusted input as key names in `options.imports`. Only use developer-controlled, static key names.","aliases":["CVE-2026-4800"],"modified":"2026-10-17T02:56:15.633068434Z","published":"2026-04-01T23:51:12Z","database_specific":{"severity":"HIGH","github_reviewed":true,"github_reviewed_at":"2026-04-01T23:51:12Z","nvd_published_at":"2026-03-31T20:16:29Z","cwe_ids":["CWE-94"]},"references":[{"type":"WEB","url":"https://github.com/lodash/lodash/security/advisories/GHSA-r5fr-rjxr-66jc"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-4800"},{"type":"WEB","url":"https://github.com/lodash/lodash/commit/3469357cff396a26c363f8c1b5a91dde28ba4b1c"},{"type":"WEB","url":"https://cna.openjsf.org/security-advisories.html"},{"type":"ADVISORY","url":"https://github.com/advisories/GHSA-35jh-r3h4-6jhm"},{"type":"PACKAGE","url":"https://github.com/lodash/lodash"}],"affected":[{"package":{"name":"lodash","ecosystem":"npm","purl":"pkg:npm/lodash"},"ranges":[{"type":"SEMVER","events":[{"introduced":"4.0.0"},{"fixed":"4.18.0"}]}],"database_specific":{"last_known_affected_version_range":"<= 4.17.23","source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/04/GHSA-r5fr-rjxr-66jc/GHSA-r5fr-rjxr-66jc.json"}},{"package":{"name":"lodash-es","ecosystem":"npm","purl":"pkg:npm/lodash-es"},"ranges":[{"type":"SEMVER","events":[{"introduced":"4.0.0"},{"fixed":"4.18.0"}]}],"database_specific":{"source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/04/GHSA-r5fr-rjxr-66jc/GHSA-r5fr-rjxr-66jc.json","last_known_affected_version_range":"<= 4.17.23"}},{"package":{"name":"lodash-amd","ecosystem":"npm","purl":"pkg:npm/lodash-amd"},"ranges":[{"type":"SEMVER","events":[{"introduced":"4.0.0"},{"fixed":"4.18.0"}]}],"database_specific":{"last_known_affected_version_range":"<= 4.17.23","source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/04/GHSA-r5fr-rjxr-66jc/GHSA-r5fr-rjxr-66jc.json"}},{"package":{"name":"lodash.template","ecosystem":"npm","purl":"pkg:npm/lodash.template"},"ranges":[{"type":"SEMVER","events":[{"introduced":"4.0.0"},{"fixed":"4.18.0"}]}],"database_specific":{"source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/04/GHSA-r5fr-rjxr-66jc/GHSA-r5fr-rjxr-66jc.json"}}],"schema_version":"1.9.0","severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H"}]},"match_confidence":0.625,"provider":"OSV"}]}}]}]}