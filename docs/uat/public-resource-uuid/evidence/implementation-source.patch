+            tenant = tenants[1 if label == "foreign" else 0]
+            if role:
+                with tenant_scope(minimal_background_context(tenant.id)):
+                    member = TenantUser(
+                        tenant_id=tenant.id, user_id=user.id, role=role, status="ACTIVE", created_at=now, updated_at=now
