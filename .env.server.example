# SBOM Analyzer 2.0.0 — Ubuntu/Docker deployment template
# Copy to .env.server, set restrictive permissions (chmod 600), and replace
# every CHANGE_ME value. Never commit the resulting .env.server file.

# ---------------------------------------------------------------------------
# IMAGE / HOST PORTS
# ---------------------------------------------------------------------------
SBOM_ANALYSER_VERSION=2.0.0
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=3000
# Keep the backend loopback-only when all browser traffic uses the authenticated
# frontend proxy. Set 0.0.0.0 only if the API must be externally reachable.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000

# ---------------------------------------------------------------------------
# POSTGRESQL — RUNTIME SECRETS
# DATABASE_URL must contain the same values and must URL-encode special password
# characters. PostgreSQL and Redis are reachable only on the Compose network.
# ---------------------------------------------------------------------------
POSTGRES_DB=sbom_analyser
POSTGRES_USER=sbom
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://sbom:CHANGE_ME_STRONG_DATABASE_PASSWORD@postgres:5432/sbom_analyser

# ---------------------------------------------------------------------------
# FRONTEND BUILD-TIME PUBLIC VARIABLES
# These are embedded by `npm run build`. Rebuild the frontend image to change
# them. They are intentionally public and must never contain secrets.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_API_URL=https://SBOM_HOST/api
NEXT_PUBLIC_HCL_IAM_ISSUER=https://HCL_IAM_HOST
NEXT_PUBLIC_HCL_IAM_CLIENT_ID=sbom-analyser-web
NEXT_PUBLIC_HCL_IAM_REDIRECT_URI=https://SBOM_HOST/auth/callback
NEXT_PUBLIC_HCL_IAM_POST_LOGOUT_REDIRECT_URI=https://SBOM_HOST
NEXT_PUBLIC_HCL_IAM_SCOPES="openid profile email offline_access sbom-analyser-api"
NEXT_PUBLIC_COMPARE_V1_FALLBACK=false

# ---------------------------------------------------------------------------
# FRONTEND RUNTIME SERVER VARIABLES
# Browser calls use /api/backend when auth is enabled; the Next.js server then
# reaches FastAPI using this Docker-internal service URL.
# ---------------------------------------------------------------------------
SBOM_API_URL=http://backend:8000
FRONTEND_HCL_IAM_CA_BUNDLE=/opt/sbom/certs/hcl-ca.crt
AUTH_TRANSACTION_KEY_FILE=/run/secrets/auth-transaction.key

# ---------------------------------------------------------------------------
# BACKEND RUNTIME VARIABLES
# ---------------------------------------------------------------------------
CORS_ORIGINS=https://SBOM_HOST
AUTH_ENABLED=true
DEV_DEFAULT_TENANT=false
API_AUTH_MODE=none
HCL_IAM_ISSUER=https://HCL_IAM_HOST
HCL_IAM_AUDIENCE=sbom-analyser-api
HCL_IAM_DISCOVERY_URL=https://HCL_IAM_HOST/.well-known/openid-configuration
HCL_IAM_JWKS_URL=https://HCL_IAM_HOST/.well-known/jwks.json
HCL_IAM_CLIENT_ID=sbom-analyser-web
HCL_IAM_ALLOWED_ALGORITHMS=RS256
HCL_IAM_ROLE_CLAIM=role
HCL_IAM_TENANT_CLAIM=tenant_id
HCL_IAM_REQUIRE_EMPLOYEE_ID=true
HCL_IAM_CA_BUNDLE=/opt/sbom/certs/hcl-ca.crt
# Required by migration 046 when identities need issuer backfill. Use the exact
# trusted issuer; do not invent a second URL.
SBOM_IDENTITY_BACKFILL_ISSUER=https://HCL_IAM_HOST

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

ANALYSIS_SOURCES=NVD,OSV,GITHUB
REPORT_NOTIFICATIONS_ENABLED=false
REPORT_NOTIFICATION_BASE_URL=https://SBOM_HOST
EMAIL_DELIVERY_ENABLED=false
EMAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_STARTTLS=true
EMAIL_VERIFICATION_FRONTEND_URL=https://SBOM_HOST/verify-email
XEOL_ENABLED=false
XEOL_DB_PATH=/var/lib/sbom/xeol/xeol.json
OLLAMA_BASE_URL=
# Set only when this is a combined corporate + public root bundle; otherwise
# leave blank and use HCL_IAM_CA_BUNDLE solely for the IAM connection.
SSL_CERT_FILE=
LOG_LEVEL=INFO
LOG_FORMAT=json
COMPARE_V1_FALLBACK=false

# ---------------------------------------------------------------------------
# OPTIONAL RUNTIME SECRETS — leave blank to disable the related integration.
# These are passed only at container start and are never Docker build arguments.
# ---------------------------------------------------------------------------
NVD_API_KEY=
GITHUB_TOKEN=
VULNDB_API_KEY=
NVD_MIRROR_FERNET_KEY=
AI_CONFIG_ENCRYPTION_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
SARVAM_API_KEY=
