# Additive to the existing HCL IAM configuration. Do not disable HCL.
AUTH_ENABLED=true
DEV_DEFAULT_TENANT=false
AUTHORIZATION_CATALOG_MODE=DATABASE
AUTHORIZATION_CATALOG_FAIL_CLOSED=true
TENANT_ROLE_ASSIGNMENT_MODE=DATABASE
TENANT_ROLE_ASSIGNMENT_FAIL_CLOSED=true
NATIVE_AUTH_ENABLED=false
NATIVE_USER_CREATION_ENABLED=false
NATIVE_JWT_ISSUER=https://sbom.example.com/native
NATIVE_JWT_AUDIENCE=sbom-analyser-api
NATIVE_JWT_ALGORITHM=RS256
NATIVE_JWT_ACCESS_TOKEN_TTL_SECONDS=900
# Inject NATIVE_JWT_PRIVATE_KEY as PEM from the deployment secret manager.
# Never commit the key or put it in a NEXT_PUBLIC variable.
NATIVE_LOGIN_MAX_FAILED_ATTEMPTS=5
NATIVE_LOGIN_LOCKOUT_SECONDS=900
NATIVE_PASSWORD_MIN_LENGTH=12
NATIVE_ACTIVATION_FRONTEND_URL=https://sbom.example.com/activate-account
# Exactly five hours; this is not an arbitrary configurable duration.
NATIVE_ACCOUNT_ACTIVATION_TTL_SECONDS=18000
# Frontend server: same native flag plus canonical HTTPS origin for mutations.
APP_ORIGIN=https://sbom.example.com

# Phase 4 password lifecycle. Disabled/pending accounts cannot reset.
NATIVE_PASSWORD_RESET_TTL_SECONDS=3600
NATIVE_PASSWORD_RESET_FRONTEND_URL=https://sbom.example.com/reset-password
# Native JWTs expire after 900s above; re-login, no native refresh token.
# Shared rate buckets are REQUIRED for multi-worker deployments.
API_RATE_LIMIT_ENABLED=true
NATIVE_AUTH_RATE_LIMIT_ENABLED=true
NATIVE_AUTH_RATE_LIMIT_STORAGE_URI=redis://redis:6379/2
NATIVE_AUTH_IP_LIMIT_PER_MINUTE=30
NATIVE_AUTH_ACCOUNT_LIMIT_PER_MINUTE=10
# Server trusted network only. Do not expose Redis publicly.
AUTH_SESSION_STORE=redis
AUTH_SESSION_REDIS_URL=redis://redis:6379/1
# Inject AUTH_SESSION_ENCRYPTION_KEY from secret manager: base64 of 32 random bytes.
# Never put encryption/session keys in NEXT_PUBLIC variables.
NATIVE_JWT_ACTIVE_KID=native-v1
# Public keys only. Each retired key requires a Unix-seconds not_after deadline.
NATIVE_JWT_VERIFICATION_KEYS_JSON={}
# Shape: {"native-v0":{"public_key":"PEM public key","not_after":UNIX_SECONDS}}

# Phase 5 production acceptance. API and worker must share this secret.
NATIVE_IAM_PRODUCTION=true
NATIVE_SECURITY_OUTBOX_ENABLED=true
# Inject NATIVE_SECURITY_OUTBOX_KEY: independent base64-encoded 32-byte AES key.
NATIVE_SECURITY_OUTBOX_MAX_ATTEMPTS=5
# Run existing Celery worker + Beat; security_mail.dispatch has no token arguments.
# Production requires EMAIL_DELIVERY_ENABLED, SMTP and matching canonical HTTPS links.
