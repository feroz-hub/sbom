# Merge into the EXISTING HTTPS ingress; this is not a second ingress server.
# In http {}: key on the immediate client IP. If another load balancer precedes
# Nginx, configure set_real_ip_from with ONLY its exact private CIDRs first,
# block direct access, and accept its sanitized header; never trust 0.0.0.0/0.
limit_req_zone $binary_remote_addr zone=iam_source:10m rate=30r/m;

# Inside the existing TLS server {}. Preserve the deployment's TLS/host policy.
location /api/auth/native/ {
    limit_req zone=iam_source burst=10 nodelay;
    limit_req_status 429;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    # Overwrite untrusted incoming values. BFF/backend do not use this as auth.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_pass http://frontend:3000;
}
# Backend must remain private. Uvicorn --no-proxy-headers preserves the actual
# peer for its aggregate source bucket. Account buckets are shared via Redis.
# Do not log request bodies, Authorization or Cookie headers.
