FROM node:20-alpine AS deps

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci


FROM deps AS builder

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

ARG NEXT_PUBLIC_AUTH_ENABLED=false
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ARG NEXT_PUBLIC_HCL_IAM_ISSUER=
ARG NEXT_PUBLIC_HCL_IAM_CLIENT_ID=
ARG NEXT_PUBLIC_HCL_IAM_REDIRECT_URI=
ARG NEXT_PUBLIC_HCL_IAM_POST_LOGOUT_REDIRECT_URI=
ARG NEXT_PUBLIC_HCL_IAM_SCOPES="openid profile email"
ARG NEXT_PUBLIC_COMPARE_V1_FALLBACK=false

ENV NEXT_PUBLIC_AUTH_ENABLED=${NEXT_PUBLIC_AUTH_ENABLED} \
    NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_HCL_IAM_ISSUER=${NEXT_PUBLIC_HCL_IAM_ISSUER} \
    NEXT_PUBLIC_HCL_IAM_CLIENT_ID=${NEXT_PUBLIC_HCL_IAM_CLIENT_ID} \
    NEXT_PUBLIC_HCL_IAM_REDIRECT_URI=${NEXT_PUBLIC_HCL_IAM_REDIRECT_URI} \
    NEXT_PUBLIC_HCL_IAM_POST_LOGOUT_REDIRECT_URI=${NEXT_PUBLIC_HCL_IAM_POST_LOGOUT_REDIRECT_URI} \
    NEXT_PUBLIC_HCL_IAM_SCOPES=${NEXT_PUBLIC_HCL_IAM_SCOPES} \
    NEXT_PUBLIC_COMPARE_V1_FALLBACK=${NEXT_PUBLIC_COMPARE_V1_FALLBACK}

COPY . .
RUN npm run build


FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

RUN addgroup --system --gid 10001 nodejs \
    && adduser --system --uid 10001 --ingroup nodejs nextjs

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
